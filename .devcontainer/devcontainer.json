{
  "name": "ATLAS v0.6 Private Workspace",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python -m pip install -e '.[dev]' && atlas seed",
  "postStartCommand": "bash .devcontainer/start-atlas.sh",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "ATLAS dashboard (private)",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python", "ms-python.vscode-pylance"] }
  }
}

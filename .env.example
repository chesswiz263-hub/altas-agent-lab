# Start with demo mode: no key is required.
ATLAS_DB_PATH=./data/atlas.db
# Keep the model endpoint keys server-side. Do NOT commit secrets.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional, user-maintained USD / 1M tokens price pairs. No vendor prices are prefilled.
# Example SHAPE ONLY (substitute actual rates for your exact model):
# ATLAS_PRICING_JSON={"openai/YOUR_MODEL":[YOUR_INPUT_RATE,YOUR_OUTPUT_RATE]}
ATLAS_PRICING_JSON=

# Optional local neural embeddings. pip install -e '.[semantic]'
ATLAS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional NLI audit. pip install -e '.[nli]' and configure a compatible 3-label model.
# ATLAS_NLI_MODEL=cross-encoder/nli-deberta-v3-small

# v0.4 optional single-operator API access token (recommended even on shared LAN).
# Generate a random 32+ byte token and DO NOT commit the value.
# ATLAS_API_TOKEN=
# When set, browser requests need the token in the header. The dashboard
# accepts it in a password field and keeps it only in page memory.
